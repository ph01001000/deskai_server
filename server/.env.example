# Required for LLM (and Gemini STT/TTS)
GEMINI_API_KEY="your-gemini-api-key"

# ---------------------------------------------------------
# Option 1: 100% Gemini (Default — only needs GEMINI_API_KEY)
# ---------------------------------------------------------
STT_PROVIDER="gemini"
STT_MODEL="gemini-3.5-flash-lite"

TTS_PROVIDER="gemini"
TTS_MODEL="gemini-3.8-flash-tts"
TTS_VOICE="Kore"

# ---------------------------------------------------------
# Option 2: Cloud Whisper + TTS (This is tested only with groq so far)
# ---------------------------------------------------------


# IMPNOTE: YOU MIGHT NEED TO ACCEPT THE CONDITIONS FOR GROQ IF YOU ARE USING IT THE FIRST TIME WHEN THE LINK IS PROVIDED IN THE TERMINAL ON THE FIRST RUN WHILE USING GROQ
# STT_PROVIDER="cloud"
# STT_API_KEY="your-groq-api-key"
# STT_ENDPOINT="https://api.groq.com/openai/v1/audio/transcriptions"
# STT_MODEL="whisper-large-v3-turbo"
#
# TTS_PROVIDER="cloud"
# TTS_API_KEY="your-groq-api-key"
# TTS_ENDPOINT="https://api.groq.com/openai/v1/audio/speech"
# TTS_MODEL="canopylabs/orpheus-v1-english"
# TTS_VOICE="troy"

# ---------------------------------------------------------
# Option 3: 100% Local STT + TTS
# ---------------------------------------------------------
# STT_PROVIDER="local"
# STT_ENDPOINT="http://127.0.0.1:8080/inference"
#
# TTS_PROVIDER="local"
# PIPER_BIN="piper"
# PIPER_MODEL="/path/to/en_US-lessac-low.onnx"